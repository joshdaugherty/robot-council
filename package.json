{
    "name": "robot-council-core",
    "private": true,
    "description": "The dashboard stylesheet this package ships compiled, so a consuming application runs no asset build.",
    "scripts": {
        "build": "tailwindcss --input resources/css/dashboard.css --output resources/dist/dashboard.css --minify",
        "check": "tailwindcss --input resources/css/dashboard.css --output /tmp/robot-council-dashboard-check.css --minify && cmp /tmp/robot-council-dashboard-check.css resources/dist/dashboard.css"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.1.0",
        "daisyui": "^5.0.0",
        "tailwindcss": "^4.1.0"
    }
}
